function qProgress(type,tgt){
  const q=G.activeQ;if(!q)return;
  for(const o of q.obj){
    if(o.done===true)continue;
    if(o.type==='kill'&&type==='kill'&&(o.tgt===tgt||o.tgt==='any')){
      o.done=(o.done||0)+1;
      msg(`OBJ: ${o.done}/${o.need}`,'#0ff');
      if(o.done>=o.need)o.done=true;
    }
    if(o.type==='killAll'&&type==='killAll')o.done=true;
  }
  qCheck();
}
function qCheck(){
  const q=G.activeQ;if(!q)return;
  if(q.obj.every(o=>o.done===true)){
    msg(`★ MISSION COMPLETE: ${q.name}`,'#ff0');
    xp(q.rew.xp);
    q.rew.items.forEach(addItem);
    G.P.missions++;
    if(q.next){
      const nq=JSON.parse(JSON.stringify(QDEFS.find(d=>d.id===q.next)));
      if(nq){G.quests.push(nq);G.activeQ=nq;msg('NEW MISSION: '+nq.name,'#0ff');}
    }else msg('ALL MISSIONS COMPLETE — OUTSTANDING!','#ff0');
  }
}
function qReach(){
  const q=G.activeQ;if(!q)return;
  const P=G.P;
  for(const o of q.obj){
    if(o.type==='reach'&&!o.done){
      if(D(P.x,P.y,o.rx,o.ry)<1.5){o.done=true;msg('OBJECTIVE REACHED!','#0ff');qCheck();}
    }
  }
}

// ── RAYCASTER ──────────────────────────────────
function raycast(){
  const P=G.P;const map=G.map;
  const half=H/2;
  const dayB=Math.sin(G.dayT*Math.PI);
  B.fillStyle=`rgb(${dayB*25|0},${dayB*35|0},${dayB*55|0})`;
  B.fillRect(0,0,W,half);
  B.fillStyle='#1a1008';B.fillRect(0,half,W,half);

  for(let x=0;x<W;x++){
    const ra=P.ang-(Math.PI/6)+(x/W)*(Math.PI/3);
    const rdx=Math.cos(ra),rdy=Math.sin(ra);
    let mx=P.x|0,my=P.y|0;
    const ddx=Math.abs(1/rdx),ddy=Math.abs(1/rdy);
    let sx,sy,sdx,sdy;
    if(rdx<0){sx=-1;sdx=(P.x-mx)*ddx;}else{sx=1;sdx=(mx+1-P.x)*ddx;}
    if(rdy<0){sy=-1;sdy=(P.y-my)*ddy;}else{sy=1;sdy=(my+1-P.y)*ddy;}
    let hit=false,side=0,wt=0,itr=0;
    while(!hit&&itr++<48){
      if(sdx<sdy){sdx+=ddx;mx+=sx;side=0;}else{sdy+=ddy;my+=sy;side=1;}
      if(mx<0||mx>=map.W||my<0||my>=map.H)break;
      wt=map.d[my][mx];if(wt>0)hit=true;
    }
    if(!hit){G.zbuf[x]=999;continue;}
    const pwd=side===0?(sdx-ddx):(sdy-ddy);
    G.zbuf[x]=pwd;
    const lh=Math.abs(H/pwd|0);
    const ds=Math.max(0,(half-lh/2)|0);
    const de=Math.min(H-1,(half+lh/2)|0);
    const tk=['','w1','w2','w3','w4','w5'][Math.min(wt,5)];
    const tex=TEX[tk];if(!tex)continue;
    let wx=side===0?P.y+pwd*rdy:P.x+pwd*rdx;
    wx-=Math.floor(wx);
    let tx=Math.floor(wx*64);
    if(side===0&&rdx>0)tx=63-tx;
    if(side===1&&rdy<0)tx=63-tx;
    if(de>ds)B.drawImage(tex,tx,0,1,64,x,ds,1,de-ds);
    if(side===1){B.fillStyle='rgba(0,0,0,.3)';B.fillRect(x,ds,1,de-ds);}
    const fog=clamp(pwd/15,.0,.9);
    B.fillStyle=`rgba(0,0,0,${fog})`;B.fillRect(x,ds,1,de-ds);
  }
}

// ── SPRITES ────────────────────────────────────
function drawSprites(){
  const P=G.P;
  const all=[];
  G.enemies.forEach(e=>{if(e.alive)all.push({x:e.x,y:e.y,kind:'enemy',d:e});});
  G.objs.forEach(o=>{if(!o.done)all.push({x:o.x,y:o.y,kind:'obj',d:o});});
  all.sort((a,b)=>D(P.x,P.y,b.x,b.y)-D(P.x,P.y,a.x,a.y));
  for(const s of all){
    const dx=s.x-P.x,dy=s.y-P.y;
    const dist=Math.sqrt(dx*dx+dy*dy);if(dist<.3)continue;
    let ang=Math.atan2(dy,dx)-P.ang;
    while(ang>Math.PI)ang-=Math.PI*2;while(ang<-Math.PI)ang+=Math.PI*2;
    if(Math.abs(ang)>Math.PI/2.1)continue;
    const scrX=((.5+ang/(Math.PI/3))*W)|0;
    const sprH=Math.abs(H/dist|0);
    const x0=Math.max(0,(scrX-sprH/2)|0),x1=Math.min(W-1,(scrX+sprH/2)|0);
    const y0=Math.max(0,(H/2-sprH/2)|0),y1=Math.min(H-1,(H/2+sprH/2)|0);
    if(s.kind==='enemy'){
      const e=s.d;const col=ETYPES[e.type].col;
      for(let px=x0;px<=x1;px++){
        if(dist>=G.zbuf[px])continue;
        const tf=(px-x0)/(x1-x0||1);
        for(let py=y0;py<=y1;py++){
          const tv=(py-y0)/(y1-y0||1);
          let c=null;
          if(tv<.15&&tf>.25&&tf<.75)c=tv<.08?'#3a4a30':'#c9a882';
          else if(tv<.68&&tf>.12&&tf<.88)c=e.aware?col:'#4a5a40';
          else if(tv<.55&&(tf<.17||tf>.83))c='#4a5a40';
          else if(tv>.65&&((tf>.2&&tf<.44)||(tf>.56&&tf<.8)))c='#3a4030';
          if(c){B.fillStyle=c;B.fillRect(px,py,1,1);}
        }
        const fog=clamp(dist/14,.0,.9);
        B.fillStyle=`rgba(0,0,0,${fog})`;B.fillRect(px,y0,1,y1-y0);
      }
      if(dist<10){
        const bw=Math.max(6,x1-x0);const bx2=scrX-bw/2|0;
        B.fillStyle='#600';B.fillRect(bx2,y0-4,bw,3);
        B.fillStyle='#0f0';B.fillRect(bx2,y0-4,Math.floor(bw*e.hp/e.maxHp),3);
      }
    }else{
      const o=s.d;
      for(let px=x0;px<=x1;px++){
        if(dist>=G.zbuf[px])continue;
        const tf=(px-x0)/(x1-x0||1);
        for(let py=y0;py<=y1;py++){
          const tv=(py-y0)/(y1-y0||1);
          if(tf>.1&&tf<.9&&tv>.1&&tv<.9){
            B.fillStyle=(tv<.12||tv>.88||tf<.12||tf>.88)?o.col:o.col2;
            B.fillRect(px,py,1,1);
          }
        }
        const fog=clamp(dist/14,.0,.9);
        B.fillStyle=`rgba(0,0,0,${fog})`;B.fillRect(px,y0,1,y1-y0);
      }
      if(dist<3){B.fillStyle=o.col;B.font='4px monospace';B.fillText(o.lbl,scrX-8,y0-2);}
    }
  }
}

