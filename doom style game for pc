const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const lerp=(a,b,t)=>a+(b-a)*t;
const D=(ax,ay,bx,by)=>Math.sqrt((bx-ax)**2+(by-ay)**2);
const R=Math.random;

function msg(txt,col='#0f0'){
