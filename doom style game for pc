function equipWep(id){
  if(!WEPS[id])return;
  const w=WEPS[id];
  G.wpn={...w,id,mag:w.mag,reloading:false,lastFired:0,recoil:0};
  msg('Equipped: '+w.name,'#0ff');
}
function hasLOS(ax,ay,tx,ty){
  for(let i=1;i<24;i++){
    const lx=lerp(ax,tx,i/24),ly=lerp(ay,ty,i/24);
    const mx=lx|0,my=ly|0;
    if(mx<0||mx>=G.map.W||my<0||my>=G.map.H)return false;
    if(G.map.d[my][mx]>0)return false;
  }
  return true;
}
function fmt(n){return n>=1e6?(n/1e6).toFixed(1)+'M':n>=1e3?(n/1e3).toFixed(1)+'K':String(n);}
function timeStr(t){const h=Math.floor(t*24),m=Math.floor(t*1440%60);return`${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`;}

// ── MAP ────────────────────────────────────────
function genMap(){
  const W=24,H=24,d=Array.from({length:H},()=>Array(W).fill(0));
  for(let i=0;i<W;i++){d[0][i]=1;d[H-1][i]=1;}
  for(let i=0;i<H;i++){d[i][0]=1;d[i][W-1]=1;}
  const structs=[
    {x:3,y:3,w:5,h:4,t:2},{x:12,y:2,w:4,h:5,t:1},{x:16,y:12,w:6,h:7,t:2},
    {x:4,y:14,w:5,h:4,t:1},{x:9,y:8,w:4,h:3,t:3},{x:18,y:3,w:4,h:4,t:2},
    {x:2,y:19,w:4,h:4,t:1},{x:13,y:18,w:6,h:5,t:3},{x:7,y:20,w:4,h:3,t:2},
  ];
  for(const s of structs){
    for(let sy=s.y;sy<s.y+s.h&&sy<H-1;sy++)
      for(let sx=s.x;sx<s.x+s.w&&sx<W-1;sx++)
        if(sx>0&&sy>0&&(sx===s.x||sx===s.x+s.w-1||sy===s.y||sy===s.y+s.h-1))
          d[sy][sx]=s.t;
    const dx=s.x+(s.w>>1);if(dx<W-1)d[s.y+s.h-1][dx]=0;
  }
  [[6,7],[7,7],[11,6],[12,6],[18,9],[19,9],[8,16],[9,16],[21,13],[21,14]].forEach(([x,y])=>{
    if(x>0&&x<W-1&&y>0&&y<H-1)d[y][x]=3;
  });
  return{d,W,H};
}

// ── PROCEDURAL TEXTURES ────────────────────────
const TEX={};
function genTex(fn){
  const tc=document.createElement('canvas');tc.width=tc.height=64;
  const tx=tc.getContext('2d');fn(tx);return tc;
}
function initTextures(){
  TEX.w1=genTex(t=>{
    for(let y=0;y<64;y+=8)for(let x=0;x<64;x+=16){
      const o=(Math.floor(y/8)%2)*8;
      const v=40+R()*15|0;
      t.fillStyle=`rgb(${v},${v},${v})`;t.fillRect((x+o)%64,y,15,7);
      t.fillStyle='rgba(0,0,0,.5)';t.fillRect((x+o)%64,y+7,15,1);t.fillRect((x+o+15)%64,y,1,8);
    }
  });
  TEX.w2=genTex(t=>{
    t.fillStyle='#283048';t.fillRect(0,0,64,64);
    for(let y=0;y<64;y+=4){t.fillStyle=y%8?'#304060':'#243050';t.fillRect(0,y,64,2);}
    for(let y=4;y<64;y+=16)for(let x=4;x<64;x+=16){t.fillStyle='#111';t.fillRect(x,y,3,3);}
  });
  TEX.w3=genTex(t=>{
    t.fillStyle='#6b5030';t.fillRect(0,0,64,64);
    for(let i=0;i<40;i++){
      const px=R()*64,py=R()*64;
      t.fillStyle=`hsl(30,${30+R()*20|0}%,${20+R()*15|0}%)`;
      t.beginPath();t.ellipse(px,py,4+R()*5,3+R()*4,R()*Math.PI,0,Math.PI*2);t.fill();
    }
  });
  TEX.w4=genTex(t=>{
    t.fillStyle='#5a3020';t.fillRect(0,0,64,64);
    t.fillStyle='#4a2010';t.fillRect(4,4,56,56);
    [[4,4],[4,34],[34,4],[34,34]].forEach(([px,py])=>{t.fillStyle='#6a4030';t.fillRect(px,py,28,28);});
    t.fillStyle='#c0a040';t.fillRect(29,29,6,6);
  });
  TEX.w5=genTex(t=>{
    for(let y=0;y<64;y++){t.fillStyle=`rgb(${50+R()*20|0},${55+R()*20|0},${60+R()*20|0})`;t.fillRect(0,y,64,1);}
  });
  TEX.sky=genTex(t=>{
    const g=t.createLinearGradient(0,0,0,64);
    g.addColorStop(0,'#101820');g.addColorStop(1,'#1a2530');
    t.fillStyle=g;t.fillRect(0,0,64,64);
  });
}

