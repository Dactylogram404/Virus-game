function xp(n){G.P.xp+=n;msg(`+${n} XP`,'#ff0');rankCheck();}
function rankCheck(){
  for(let i=RANKS.length-1;i>=0;i--){
    if(G.P.xp>=RANKS[i].xp&&G.P.rankIdx<i){
      G.P.rankIdx=i;G.P.rank=RANKS[i].n;
      msg(`★ PROMOTED: ${RANKS[i].full}!`,'#ff0');
    }
  }
}
function addItem(id){
