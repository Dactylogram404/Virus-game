  // Corner cube
  G.cubeA+=.018;
  const cpts=CV3.map(([x,y,z])=>{const p=p3d(x,y,z,G.cubeA*.5,G.cubeA,0);return{sx:20+p.sx*9,sy:H-18+p.sy*9};});
  CE.forEach(([a,b])=>{B.strokeStyle='#040';B.lineWidth=.8;B.beginPath();B.moveTo(cpts[a].sx,cpts[a].sy);B.lineTo(cpts[b].sx,cpts[b].sy);B.stroke();});
}

// ── CHARACTER CREATION ─────────────────────────
function drawCharCreate(){
  B.fillStyle='#000';B.fillRect(0,0,W,H);
  B.strokeStyle='#0f0';B.lineWidth=2;B.strokeRect(4,4,W-8,H-8);
  B.fillStyle='#ff0';B.font='8px monospace';B.fillText('=== ENLISTMENT OFFICE ===',W/2-58,14);
  const steps=['NAME','MOS','STATS','CONFIRM'];
  steps.forEach((s,i)=>{
    const done=G.charStep>i,cur=G.charStep===i;
    B.fillStyle=done?'#040':cur?'#0f0':'#222';B.fillRect(10+i*76,17,73,8);
    B.fillStyle=done?'#0f0':cur?'#000':'#333';B.font='5px monospace';
    B.fillText((done?'✓ ':'')+s,12+i*76,24);
  });
  const step=G.charStep;
  if(step===0){
    B.fillStyle='#0f0';B.font='6px monospace';B.fillText('ENTER SOLDIER NAME:',W/2-55,42);
    B.strokeStyle='#0f0';B.lineWidth=1;B.strokeRect(W/2-65,47,130,14);
    B.fillStyle='#0f0';B.font='9px monospace';
    B.fillText(G.charName+(Math.floor(G.t/500)%2?'_':''),W/2-63,59);
    B.fillStyle='#333';B.font='5px monospace';B.fillText('Letters/numbers, max 12 chars',W/2-52,74);
    B.fillText('[ENTER] Confirm',W/2-34,84);
  }else if(step===1){
    B.fillStyle='#0f0';B.font='6px monospace';B.fillText('SELECT MOS (Military Occupational Specialty):',10,33);
    MOS.forEach((m,i)=>{
      const sel=G.charMOS===i;
      B.fillStyle=sel?'rgba(0,255,0,.1)':'#040';B.fillRect(10,36+i*18,W-20,16);
      if(sel){B.strokeStyle='#0f0';B.lineWidth=1;B.strokeRect(10,36+i*18,W-20,16);}
      B.fillStyle=sel?'#ff0':'#0a0';B.font='5px monospace';
      B.fillText(`[${m.code}] ${m.name}`,14,47+i*18);
      B.fillStyle=sel?'#0f0':'#333';B.fillText(m.desc,110,47+i*18);
    });
    const m=MOS[G.charMOS];
    B.fillStyle='#0ff';B.font='4px monospace';
    B.fillText('BONUS: '+Object.entries(m.bSt).map(([k,v])=>`+${v}${k}`).join(' ')
      +' | SKILLS: '+Object.entries(m.bSk).map(([k,v])=>`+${v}${k}`).join(' '),10,H-12);
    B.fillStyle='#444';B.font='5px monospace';B.fillText('[↑↓] Select   [ENTER] Confirm',10,H-4);
  }else if(step===2){
    B.fillStyle='#0f0';B.font='6px monospace';B.fillText(`ALLOCATE ATTRIBUTES — ${G.statPts} pts left`,10,33);
    const sn=['STR','AGI','INT','PER','END','CHR','LCK'];
    const sd=['Melee/Carry','Speed/Stealth','XP Bonus','Accuracy','HP & Endure','Leadership','Luck/Crits'];
    sn.forEach((s,i)=>{
      const sel=G.statSel===i,v=G.charStats[s];
      B.fillStyle=sel?'#ff0':'#0a0';B.font='6px monospace';B.fillText(s+':',12,46+i*20);
      bar(38,39+i*20,90,9,v/10,sel?'#ff0':'#060','#111',null);
      B.fillStyle=sel?'#ff0':'#0f0';B.fillText(String(v),132,46+i*20);
      if(sel){B.fillStyle='#0ff';B.fillText('◄ ►',145,46+i*20);}
      B.fillStyle='#333';B.font='5px monospace';B.fillText(sd[i],163,46+i*20);
    });
    B.fillStyle='#444';B.font='5px monospace';B.fillText('[↑↓]Sel  [←→]Adj  [ENTER]Confirm',10,H-4);
  }else{
    B.fillStyle='#0f0';B.font='7px monospace';B.fillText('=== CONFIRM ENLISTMENT ===',W/2-58,33);
    const m=MOS[G.charMOS];let y=44;
    B.font='5px monospace';
    [['NAME',G.charName||'SOLDIER'],['MOS',`${m.code} ${m.name}`],['RANK','PVT E-1'],
     ...['STR','AGI','INT','PER','END','CHR','LCK'].map(s=>[s,String(G.charStats[s])])
    ].forEach(([l,v])=>{
      B.fillStyle='#444';B.fillText(l+':',30,y);B.fillStyle='#0f0';B.fillText(v,100,y);y+=9;
    });
    B.fillStyle='#0f0';B.font='6px monospace';
    B.fillText('[ENTER] ENLIST   [BACKSPACE] Back',W/2-65,y+10);
  }
}

function handleCharKey(k){
  const step=G.charStep;
  if(step===0){
    if(k==='Enter'&&G.charName.length>0)G.charStep=1;
    else if(k==='Backspace')G.charName=G.charName.slice(0,-1);
    else if(k.length===1&&G.charName.length<12&&/[a-zA-Z0-9 ]/.test(k))G.charName+=k.toUpperCase();
  }else if(step===1){
    if(k==='ArrowUp')G.charMOS=Math.max(0,G.charMOS-1);
    if(k==='ArrowDown')G.charMOS=Math.min(MOS.length-1,G.charMOS+1);
    if(k==='Enter')G.charStep=2;
    if(k==='Backspace')G.charStep=0;
  }else if(step===2){
    const sn=['STR','AGI','INT','PER','END','CHR','LCK'];
    if(k==='ArrowUp')G.statSel=Math.max(0,G.statSel-1);
    if(k==='ArrowDown')G.statSel=Math.min(6,G.statSel+1);
    if(k==='ArrowRight'&&G.statPts>0&&G.charStats[sn[G.statSel]]<10){G.charStats[sn[G.statSel]]++;G.statPts--;}
    if(k==='ArrowLeft'&&G.charStats[sn[G.statSel]]>1){G.charStats[sn[G.statSel]]--;G.statPts++;}
    if(k==='Enter')G.charStep=3;
    if(k==='Backspace')G.charStep=1;
  }else{
    if(k==='Enter')startGame();
    if(k==='Backspace')G.charStep=2;
  }
}

// ── START GAME ─────────────────────────────────
function startGame(){
  const P=G.P;
  P.name=G.charName||'SOLDIER';
  const m=MOS[G.charMOS];P.mos=m.name;
  P.stats={...G.charStats};
  Object.entries(m.bSt).forEach(([k,v])=>P.stats[k]=Math.min(10,P.stats[k]+v));
  Object.entries(m.bSk).forEach(([k,v])=>{if(P.skills[k]!==undefined)P.skills[k]=Math.min(100,P.skills[k]+v);});
  P.maxHP=80+P.stats.END*8;P.hp=P.maxHP;
  P.maxStamina=80+P.stats.AGI*6;P.stamina=P.maxStamina;
  P.maxArmor=60+P.stats.STR*2;P.armor=P.maxArmor;
  // Starter items
  addItem('medkit');addItem('fieldDress');addItem('mre');addItem('water');
  if(m.code==='68W'){addItem('medkit');addItem('medkit');addItem('morphine');}
  if(m.code==='12B'||m.code==='18X'){P.c4=2;P.grenades=4;}
  if(m.code==='11B'||m.code==='75B'){P.ammo.rifle+=m.code==='11B'?90:60;}
  equipWep('m4');
  G.map=genMap();
  initTextures();
  spawnEnemies();
  spawnObjs();
  initQuests();
  G.radioT=8000;
  G.dayT=.35;
  G.alertLvl=0;
  G.msgs=[];
  G.particles=[];
  G.invTab=0;G.invSel=0;
  setTimeout(()=>{msg('=== OPERATION IRON WOLF ===','#ff0');},500);
  setTimeout(()=>{msg('MISSION: '+G.activeQ.name,'#0ff');},1200);
  setTimeout(()=>{msg('[RADIO] All units, weapons free.','#0a8');},2500);
  G.st='playing';
}

// ── INPUT ──────────────────────────────────────
document.addEventListener('keydown',e=>{
  G.keys[e.key]=true;
  if(G.st==='charCreate'){handleCharKey(e.key);return;}
  if(G.st==='menu'){
    if(e.key==='ArrowUp')G.menuSel=Math.max(0,G.menuSel-1);
    if(e.key==='ArrowDown')G.menuSel=Math.min(3,G.menuSel+1);
    if(e.key==='Enter'&&G.menuSel===0){G.charStep=0;G.charName='';G.charMOS=0;G.charStats={STR:5,AGI:5,INT:5,PER:5,END:5,CHR:5,LCK:5};G.statPts=21;G.statSel=0;G.st='charCreate';}
    return;
  }
  if(G.st==='paused'){
    if(e.key==='ArrowUp')G.pauseSel=Math.max(0,G.pauseSel-1);
    if(e.key==='ArrowDown')G.pauseSel=Math.min(4,G.pauseSel+1);
    if(e.key==='Escape')G.st='playing';
    if(e.key==='Enter'){const nx=['playing','inventory','mapview','stats','menu'][G.pauseSel];G.st=nx==='menu'?'menu':nx;if(nx==='menu')G.menuSel=0;}
    return;
  }
  if(G.st==='inventory'){
    if(!G.invTab)G.invTab=0;
    if(e.key==='ArrowLeft')G.invTab=Math.max(0,G.invTab-1);
    if(e.key==='ArrowRight')G.invTab=Math.min(3,G.invTab+1);
    if(e.key==='ArrowUp')G.invSel=Math.max(0,(G.invSel||0)-1);
    if(e.key==='ArrowDown')G.invSel=(G.invSel||0)+1;
    if(e.key==='i'||e.key==='Escape')G.st='playing';
    if(e.key==='Enter'){
      const P=G.P;
      const filt=G.invTab===1?P.inv.filter(i=>i.type==='consumable')
                :G.invTab===3?P.inv.filter(i=>['equipment','armor','helmet','medal'].includes(i.type)):P.inv;
      const item=filt[G.invSel||0];
      if(item&&item.type==='consumable'){
        if(item.eff==='heal'){P.hp=Math.min(P.maxHP,P.hp+item.val);msg(`Healed +${item.val} HP`,'#0f0');}
        if(item.eff==='food'){P.hunger=Math.min(100,P.hunger+item.val);msg('Hunger restored','#0f8');}
        if(item.eff==='water'){P.thirst=Math.min(100,P.thirst+item.val);msg('Thirst restored','#08f');}
        if(item.eff==='adren'){P.stamina=P.maxStamina;msg('Adrenaline rush!','#ff0');}
        if(item.eff==='energy'){P.stamina=Math.min(P.maxStamina,P.stamina+item.val);msg('+Stamina','#ff0');}
        const idx=P.inv.indexOf(item);if(idx>=0)P.inv.splice(idx,1);
        G.invSel=Math.max(0,(G.invSel||0)-1);
      }
    }
    return;
  }
  if((G.st==='mapview')&&(e.key==='m'||e.key==='Escape'))G.st='playing';
  if((G.st==='stats')&&(e.key==='p'||e.key==='Escape'))G.st='playing';
  if(e.key==='F11')e.preventDefault();
});
document.addEventListener('keyup',e=>{delete G.keys[e.key];});

// Mouse
CV.addEventListener('click',()=>{
  if(!G.mlocked&&G.st==='playing'){CV.requestPointerLock();}
});
document.addEventListener('pointerlockchange',()=>{G.mlocked=!!document.pointerLockElement;});
document.addEventListener('mousemove',e=>{if(G.mlocked&&G.st==='playing'){G.mdx+=e.movementX;G.mdy+=e.movementY;}});
document.addEventListener('mousedown',e=>{if(e.button===0)G.mb=true;});
document.addEventListener('mouseup',e=>{if(e.button===0)G.mb=false;});
// Touch
CV.addEventListener('touchstart',e=>{e.preventDefault();G.mb=true;},{passive:false});
CV.addEventListener('touchend',e=>{e.preventDefault();G.mb=false;},{passive:false});

// D-pad
function mobileBtn(id,key,down=true){
  const el=document.getElementById(id);if(!el)return;
  const on=()=>{G.keys[key]=true;};const off=()=>{delete G.keys[key];};
  el.addEventListener('touchstart',e=>{e.preventDefault();on();},{passive:false});
  el.addEventListener('touchend',e=>{e.preventDefault();off();},{passive:false});
  el.addEventListener('mousedown',on);el.addEventListener('mouseup',off);
}
mobileBtn('bw','w');mobileBtn('bs','s');mobileBtn('ba','ArrowLeft');mobileBtn('bd','ArrowRight');
mobileBtn('bql','q');mobileBtn('bqr','e');
document.getElementById('bfire').addEventListener('touchstart',e=>{e.preventDefault();G.mb=true;},{passive:false});
document.getElementById('bfire').addEventListener('touchend',e=>{e.preventDefault();G.mb=false;},{passive:false});
document.getElementById('breload').addEventListener('touchstart',e=>{e.preventDefault();reload();},{passive:false});
document.getElementById('binv').addEventListener('touchstart',e=>{e.preventDefault();G.st=G.st==='inventory'?'playing':'inventory';},{passive:false});
document.getElementById('bmap').addEventListener('touchstart',e=>{e.preventDefault();G.st=G.st==='mapview'?'playing':'mapview';},{passive:false});
document.getElementById('bgren').addEventListener('touchstart',e=>{e.preventDefault();throwGrenade();},{passive:false});

// ── GAME LOOP ──────────────────────────────────
function loop(ts){
  requestAnimationFrame(loop);
  G.dt=Math.min(ts-G.lt,50);G.t=ts;G.lt=ts;

  B.clearRect(0,0,W,H);

  if(G.st==='loading'){
    drawLoading(G.dt);
  }else if(G.st==='menu'){
    drawMenu();
  }else if(G.st==='charCreate'){
    drawCharCreate();
  }else if(G.st==='playing'){
    updatePlayer(G.dt);
    updateEnemies(G.dt);
    raycast();
    drawSprites();
    drawWep();
    drawHUD();
  }else if(G.st==='inventory'){
    // Still render world behind
    if(G.map){raycast();drawSprites();}
    drawInventory();
  }else if(G.st==='mapview'){
    if(G.map){raycast();}
    drawMapScreen();
  }else if(G.st==='stats'){
    if(G.map){raycast();drawSprites();}
    drawStats();
  }else if(G.st==='paused'){
    if(G.map){raycast();drawSprites();drawWep();drawHUD();}
    drawPause();
  }else if(G.st==='dead'){
    drawDead();
  }

  CX.drawImage(BUF,0,0);
}

requestAnimationFrame(loop);
</script>
