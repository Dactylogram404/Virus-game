// ── COMBAT ─────────────────────────────────────
function shoot(){
  const w=G.wpn,P=G.P;
  if(w.reloading)return;
  if(G.t-w.lastFired<w.rate)return;
  if(w.mag<=0){reload();return;}
  w.mag--;w.lastFired=G.t;w.recoil=1;G.shootFX=8;
  const spr=w.spread*(1+w.recoil*.5);
  const ra=P.ang+(R()-.5)*spr*2;
  let best=null,bestD=w.range;
  for(const e of G.enemies){
    if(!e.alive)continue;
    const dx=e.x-P.x,dy=e.y-P.y;
    const dist=Math.sqrt(dx*dx+dy*dy);if(dist>w.range)continue;
    const dot=(dx/dist)*Math.cos(ra)+(dy/dist)*Math.sin(ra);
    if(dot<.96)continue;
    if(!hasLOS(P.x,P.y,e.x,e.y))continue;
    if(dist<bestD){bestD=dist;best=e;}
  }
  if(best){
    let dmg=w.dmg*(.7+R()*.6);
    const crit=R()<.05+P.stats.LCK*.01;
    if(crit){dmg*=2.5;msg('CRITICAL HIT!','#ff0');}
    dmg*=Math.max(.3,1-bestD/w.range*.6);
    dmg=dmg|0;best.hp-=dmg;best.aware=true;
    msg(`HIT: -${dmg}`,'#f80');
    for(let i=0;i<5;i++)G.particles.push({x:best.x,y:best.y,vx:(R()-.5)*.05,vy:(R()-.5)*.05,life:400,col:'#c00'});
    if(best.hp<=0){
      best.alive=false;P.kills++;xp(ETYPES[best.type].xp);
      msg(ETYPES[best.type].name+' ELIMINATED','#0f0');
      qProgress('kill',best.type);
      if(G.enemies.every(e=>!e.alive))qProgress('killAll');
    }
  }
}
function reload(){
  const w=G.wpn,P=G.P;
  if(w.reloading||w.atype==='melee')return;
  const avail=P.ammo[w.atype]||0;
  if(avail<=0){msg('OUT OF AMMO!','#f00');return;}
  w.reloading=true;msg('RELOADING...','#ff0');
  setTimeout(()=>{
    const need=w.maxMag-w.mag,take=Math.min(need,P.ammo[w.atype]);
    w.mag+=take;P.ammo[w.atype]-=take;w.reloading=false;msg('RELOADED','#0f0');
  },w.reloadMs);
}
function throwGrenade(){
  const P=G.P;if(P.grenades<=0){msg('NO GRENADES!','#f00');return;}
  P.grenades--;msg('GRENADE OUT!','#ff0');
  const tx=P.x+Math.cos(P.ang)*4,ty=P.y+Math.sin(P.ang)*4;
  setTimeout(()=>{
    G.hitFX=12;msg('FRAG!','#f80');
    G.enemies.forEach(e=>{
      if(!e.alive)return;
      const d=D(e.x,e.y,tx,ty);
      if(d<2.5){
        e.hp-=Math.floor(80*(1-d/2.5));
        if(e.hp<=0){e.alive=false;P.kills++;xp(ETYPES[e.type].xp);qProgress('kill',e.type);}
      }
    });
    xp(20);
  },2000);
}

// ── ENEMY AI ───────────────────────────────────
function updateEnemies(dt){
  const P=G.P;
  for(const e of G.enemies){
    if(!e.alive)continue;
    if(e.type==='ied'){
      if(D(P.x,P.y,e.x,e.y)<1.2){
        e.alive=false;
        const dmg=Math.floor(200*(1-P.armor/P.maxArmor*.45));
        P.hp-=dmg;G.hitFX=20;
        msg(`IED! -${dmg} HP`,'#f00');
        if(P.hp<=0)G.st='dead';
      }
      continue;
    }
    const dx=P.x-e.x,dy=P.y-e.y;
    const dist=Math.sqrt(dx*dx+dy*dy);
    e.ang=Math.atan2(dy,dx);
    if(!e.aware){
      if(hasLOS(e.x,e.y,P.x,P.y)&&dist<10){
        e.awareT+=dt;
        if(e.awareT>700){e.aware=true;G.alertLvl=Math.min(3,G.alertLvl+1);msg('CONTACT!','#f00');}
      }else e.awareT=Math.max(0,e.awareT-dt);
      continue;
    }
    // Move toward player
    if(dist>1.5){
      const spd=ETYPES[e.type].spd*dt;
      const nx=e.x+(dx/dist)*spd,ny=e.y+(dy/dist)*spd;
      if(G.map.d[ny|0][nx|0]===0){e.x=nx;e.y=ny;}
      else{
        if(G.map.d[(P.y|0)][nx|0]===0)e.x=nx;
        else if(G.map.d[ny|0][(P.x|0)]===0)e.y=ny;
      }
    }
    // Attack
    const et=ETYPES[e.type];
    if(dist<=et.atkR&&G.t-e.lastAtk>et.atkRt&&hasLOS(e.x,e.y,P.x,P.y)){
      e.lastAtk=G.t;
      const hitChance=.65-dist/et.atkR*.3+(P.crouching?.1:0)-(P.stats.AGI*.02);
      if(R()<hitChance){
        const dmg=Math.floor(et.dmg*(1-P.armor/P.maxArmor*.45)*(.7+R()*.6));
        P.hp-=dmg;G.hitFX=8;msg(`TAKING FIRE -${dmg}`,'#f00');
        if(P.hp<=0)G.st='dead';
      }else msg('NEAR MISS!','#555');
    }
  }
  if(!G.enemies.some(e=>e.alive&&e.aware))G.alertLvl=Math.max(0,G.alertLvl-.0005*dt);
}

// ── PLAYER ─────────────────────────────────────
function updatePlayer(dt){
  const P=G.P,K=G.keys,map=G.map;
  P.sprinting=K.Shift&&!P.crouching;
  P.crouching=K.Control||K.c;
  const spdM=(P.sprinting?1.8:P.crouching?.4:1)*(.5+P.stamina/P.maxStamina*.5)*(1+P.stats.AGI*.04);
  const spd=.003*dt*spdM;
  const rot=.002*dt;

  if(K.ArrowLeft||K.a)P.ang-=rot;
  if(K.ArrowRight||K.d)P.ang+=rot;
  if(G.mdx){P.ang+=G.mdx*.003;G.mdx=0;}

  let mx=0,my=0;
  if(K.ArrowUp||K.w){mx+=Math.cos(P.ang)*spd;my+=Math.sin(P.ang)*spd;}
  if(K.ArrowDown||K.s){mx-=Math.cos(P.ang)*spd;my-=Math.sin(P.ang)*spd;}
  if(K.q){mx+=Math.cos(P.ang-Math.PI/2)*spd;my+=Math.sin(P.ang-Math.PI/2)*spd;}
  if(K.e){mx+=Math.cos(P.ang+Math.PI/2)*spd;my+=Math.sin(P.ang+Math.PI/2)*spd;}

  const nx=P.x+mx,ny=P.y+my,pad=.3;
  if(map.d[P.y|0][(nx+pad)|0]===0&&map.d[P.y|0][(nx-pad)|0]===0)P.x=nx;
  if(map.d[(ny+pad)|0][P.x|0]===0&&map.d[(ny-pad)|0][P.x|0]===0)P.y=ny;

  if(P.sprinting&&(mx||my))P.stamina=Math.max(0,P.stamina-dt*.04);
  else P.stamina=Math.min(P.maxStamina,P.stamina+dt*.02);

  G.wpn.recoil=Math.max(0,G.wpn.recoil-dt*.006);
  G.shootFX=Math.max(0,G.shootFX-1);
  G.hitFX=Math.max(0,G.hitFX-1);

  if(G.mb||K[' '])shoot();
  if(K.r||K.R){reload();delete K.r;delete K.R;}
  if(K.g){throwGrenade();delete K.g;}
  if(K.i){G.st='inventory';delete K.i;}
  if(K.m){G.st='mapview';delete K.m;}
  if(K.p){G.st='stats';delete K.p;}
  if(K.Escape){G.st='paused';delete K.Escape;}
  '1234567'.split('').forEach((n,i)=>{
    if(K[n]){equipWep(['m4','m9','m14','knife','m249','shotgun','barrett'][i]);delete K[n];}
  });

  G.dayT=(G.dayT+dt*.000012)%1;
  P.hunger=Math.max(0,P.hunger-dt*.0004);
  P.thirst=Math.max(0,P.thirst-dt*.0008);
  if(P.hunger<10||P.thirst<10)P.hp=Math.max(1,P.hp-dt*.002);
  if(P.morale>80)P.hp=Math.min(P.maxHP,P.hp+dt*.0015);

  G.particles=G.particles.filter(p=>{p.x+=p.vx;p.y+=p.vy;p.life-=dt;return p.life>0;});

  // Pickup
  G.objs.forEach(o=>{
    if(o.done)return;
    if(D(P.x,P.y,o.x,o.y)<.85){
      o.done=true;
      if(o.type==='ammo'){P.ammo.rifle=Math.min(300,P.ammo.rifle+60);msg('+60 Rifle Ammo','#ff0');xp(15);}
      if(o.type==='med'){P.hp=Math.min(P.maxHP,P.hp+50);msg('Medkit +50 HP','#0f0');xp(20);}
      if(o.type==='weapon'){const ws=Object.keys(WEPS);equipWep(ws[R()*ws.length|0]);xp(50);}
      if(o.type==='intel'){msg('Intel secured! +300 XP','#0ff');xp(300);}
      if(o.type==='cache'){msg('Cache located!','#f80');xp(150);}
      if(o.type==='equip'){addItem('iotv');msg('Gear acquired!','#a0f');xp(80);}
    }
  });

  qReach();

  G.radioT-=dt;
  if(G.radioT<=0){
    G.radioT=15000+R()*25000;
    msg('[RADIO] '+RADIO[R()*RADIO.length|0],'#0a8');
  }
}

